USERNAME=
PASSWORD=
# 浏览器登录 new.spdex.com 后，从 DevTools 复制对 *.spdex.com 生效的 Cookie：
# SPDEX_COOKIE=
# 若接口使用 Bearer（可选）：
# SPDEX_AUTHORIZATION=

# The Odds API：赛程、h2h 欧赔、spreads 让球赔率
# THE_ODDS_API_KEY=

# Betfair Exchange API：真实交易所价格、挂单、traded volume
# 需要先在 Betfair 外部完成登录并拿到 session token；本工具不做证书登录。
# BETFAIR_APP_KEY=
# BETFAIR_SESSION_TOKEN=

# Titan007：CLI 默认赛程源 live；若要 bf 域 bfdata.js 可设 bf
# TITAN007_SCHEDULE_SOURCE=bf
# 合并澳客「必发盈亏」页到 Bf*（队名+时间启发式匹配）
# TITAN007_OKOOO_BIFA=1
# TITAN007_OKOOO_IDS=2906745=1316319
# OKOOO_TITAN_MAP_PATH=/absolute/or/relative/okooo_titan_map.json
# 浏览器登录 www.okooo.cn 后 DevTools 复制 Cookie；betfa 与 exchanges/detail 明细页共用
# OKOOO_COOKIE=
# 正盘口时用主客均水推断「主让→负盘口」（与 vip 亚指页一致）；设 0 关闭
# TITAN007_ASIAN_SIGN_FROM_WATER=1
# 二遍：用 1x2 欧赔均值或澳客 BfOdds 胜赔纠正「受让方低水」误判（半球~一球）；设 0 关闭
# TITAN007_ASIAN_SIGN_FROM_ML=1
